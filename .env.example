# RAGLens environment configuration (copy to .env)

# Embeddings: minilm | lsa | hash  (minilm falls back to lsa when the model cannot be loaded)
EMBEDDER=minilm
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
LSA_COMPONENTS=128

# Chunking
CORPUS_DIR=data/sample_corpus
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval & reranker
DEFAULT_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false

# LLM providers: fake | ollama | openai
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Refusal gate (share of question words the best passage must contain)
REFUSAL_THRESHOLD=0.35

# Server & storage
INDEX_DIR=data/index
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_MB=5
EVAL_DATASET=data/eval/qa.jsonl
EVAL_OUTPUT_DIR=docs/proof
