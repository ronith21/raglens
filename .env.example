# RAGLens environment configuration. Copy to .env and adjust.

# Embeddings (set USE_HASH_EMBEDDER=true for a fully offline, model-free setup)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
USE_HASH_EMBEDDER=false
HASH_EMBED_DIM=384

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval & reranker
DEFAULT_TOP_K=5
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RERANKER=false

# LLM providers: ollama | openai | fake
LLM_PROVIDER=fake
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Pipeline: refuse when the best retrieval score is below MIN_RELEVANCE_THRESHOLD, or when the
# top passages contain less than MIN_QUERY_COVERAGE of the question's content words.
MIN_RELEVANCE_THRESHOLD=0.01
MIN_QUERY_COVERAGE=0.5
# Refusal gate: auto (learned if data/models/refusal_gate.json matches the embedder) | rule | learned
REFUSAL_GATE=auto
GATE_MODEL_PATH=data/models/refusal_gate.json
RERANK_CANDIDATES=20

# Observability: JSON access logs, and a local SQLite log of questions that feeds /analytics.
# Set QUERY_LOG_ENABLED=false if questions may contain sensitive data.
LOG_LEVEL=INFO
LOG_JSON=false
QUERY_LOG_ENABLED=true
QUERY_LOG_PATH=data/logs/queries.db
# Mask e-mails, IBANs, card and phone numbers before questions are logged.
REDACT_PII=true
# Optional: require X-API-Key on POST /ingest, POST /eval and GET /analytics (empty = open).
API_KEY=

# Paths & server
CORPUS_DIR=data/sample_corpus
EVAL_DATASET=data/eval/qa.jsonl
# Results file shown in the UI's Evaluation tab (written by `make eval` / `make eval-banking`)
EVAL_RESULTS_PATH=docs/proof/eval_results.json
INDEX_DIR=data/index
API_HOST=0.0.0.0
API_PORT=8000
# Used by the Streamlit UI to reach the API
API_URL=http://localhost:8000
